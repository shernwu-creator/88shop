.logo .logo-img {
  height: 100%;
}
.logo .logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1;
}
.logo .logo-main {
  font-size: 1.2rem;
}
.logo .logo-sub {
  font-size: 0.8rem;
  color: var(--text-main);
}
.desktop-nav ul {
  display: flex;
  gap: 20px;
}
.desktop-nav a {
  font-weight: 500;
  transition: color 0.2s;
}
.desktop-nav a:hover {
  color: var(--primary-ink);
}

/* ==========================================================================
   7. 路由 Active 狀態 (Router Active State)
   ========================================================================== */
.desktop-nav a.active {
  color: var(--primary-ink);
  border-bottom: 2px solid var(--primary-ink);
  padding-bottom: 4px;
  font-weight: 700;
}

.mobile-menu a.active {
  background-color: var(--bg-card);
  color: var(--primary-ink);
  font-weight: 700;
  border-left: 4px solid var(--primary-ink);
}

.search-box {
  display: flex;
  flex: 1;
  max-width: 300px;
  margin: 0 20px;
  border: 2px solid var(--primary);
